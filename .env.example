# 复制为 .env 后按需修改。.env 不要提交到仓库。

# dev | prod
DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# 生产数据库（dev 默认用 SQLite，无需配置）
DB_NAME=ealgo
DB_USER=ealgo
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
# 本地没起 Redis 时设为 1，任务改为同步执行
CELERY_TASK_ALWAYS_EAGER=0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# 前端地址（CORS）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 初始超级管理员，留空密码则 bootstrap 时随机生成并打印一次
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_EMAIL=root@e-algo-rank.local
ROOT_ADMIN_PASSWORD=
