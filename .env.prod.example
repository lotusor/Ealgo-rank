# 生产环境变量模板。复制为 .env.prod 后填写真实值（.env.prod 已被 .gitignore 忽略，勿提交）。
# 容器采用 host 网络模式，PG/Redis 直连宿主 127.0.0.1（宝塔内置实例）。

# 环境
DJANGO_ENV=prod
DJANGO_SECRET_KEY=<CHANGE-ME-strong-random>
DJANGO_ALLOWED_HOSTS=rank.eacm.cn,127.0.0.1
LOG_LEVEL=INFO

# 生产数据库（宝塔内置 PostgreSQL，host 网络直连 127.0.0.1）
DB_NAME=ealgo
DB_USER=ealgo
DB_PASSWORD=<CHANGE-ME>
DB_HOST=127.0.0.1
DB_PORT=5432

# 宝塔内置 Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS：API 与前端同域（rank.eacm.cn）无需跨域；
# 仅浏览器直连 passport 刷新令牌时需要 passport 侧放行 rank.eacm.cn（属 passport 配置）
CORS_ALLOWED_ORIGINS=https://rank.eacm.cn
CSRF_TRUSTED_ORIGINS=https://rank.eacm.cn

# 统一认证中心（生产）
PASSPORT_BASE_URL=https://passport.eacm.cn
PASSPORT_ISSUER=lotus-passport

# 初始超级管理员（密码留空则 bootstrap 随机生成并打印一次）
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_EMAIL=root@eacm.cn
ROOT_ADMIN_PASSWORD=<CHANGE-ME-or-blank>
